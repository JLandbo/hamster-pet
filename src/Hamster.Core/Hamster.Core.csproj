<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="ReverseMarkdown" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Pet\Hamster PNG\*" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Languages\*.json" LogicalName="Languages/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Claude\DefaultInstructions.md" LogicalName="DefaultInstructions.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hamster.Tests" />
  </ItemGroup>

</Project>
