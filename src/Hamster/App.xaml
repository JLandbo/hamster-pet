<Application x:Class="Hamster.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <SolidColorBrush x:Key="Surface" Color="#F0262626" />
                    <SolidColorBrush x:Key="Edge" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="Text" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="Muted" Color="#B8B8B8" />
                    <SolidColorBrush x:Key="Attention" Color="#F5C542" />
                    <SolidColorBrush x:Key="AttentionSoft" Color="#24F5C542" />
                    <SolidColorBrush x:Key="OnAttention" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="Input" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="Button" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="Link" Color="#6FA8FF" />
                    <SolidColorBrush x:Key="Busy" Color="#E08F60" />
                    <SolidColorBrush x:Key="Error" Color="#FF6B6B" />
                    <SolidColorBrush x:Key="Handle" Color="#99FFFFFF" />
                    <SolidColorBrush x:Key="Hover" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="Card" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="Box" Color="#08FFFFFF" />
                    <SolidColorBrush x:Key="BoxEdge" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="Epic" Color="#59904EE2" />
                    <SolidColorBrush x:Key="EpicText" Color="#E6D6FF" />
                    <SolidColorBrush x:Key="Task" Color="#474BADE8" />
                    <SolidColorBrush x:Key="TaskText" Color="#D6EEFF" />
                    <SolidColorBrush x:Key="SubTask" Color="#472EC4B6" />
                    <SolidColorBrush x:Key="SubTaskText" Color="#D2FFF9" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <DropShadowEffect x:Key="Shadow" BlurRadius="12" ShadowDepth="2" Opacity="0.35" />

            <Style x:Key="PillButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                <Setter Property="Background" Value="{DynamicResource Button}" />
                <Setter Property="Padding" Value="14,5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
                <Setter Property="Background" Value="{DynamicResource Attention}" />
                <Setter Property="Foreground" Value="{DynamicResource OnAttention}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Padding" Value="12,7" />
            </Style>

            <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Padding" Value="7,7" />
            </Style>

            <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                <Setter Property="FontSize" Value="9" />
                <Setter Property="Padding" Value="4" />
            </Style>

            <Style x:Key="Segment" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Back" CornerRadius="6" Padding="10,3" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource Attention}" />
                                    <Setter Property="Foreground" Value="{DynamicResource OnAttention}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Back" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="FlowDocument">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="PagePadding" Value="0" />
            </Style>
            <Style TargetType="Hyperlink">
                <Setter Property="Foreground" Value="{DynamicResource Link}" />
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="6" />
                <Setter Property="ContextMenu" Value="{x:Null}" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="{DynamicResource Handle}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{DynamicResource Input}" BorderBrush="{DynamicResource Edge}" BorderThickness="1">
                                    <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource OnAttention}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Muted}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Attention}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Attention}" />
                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ChoiceItem" TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="8,5,14,5">
                                <DockPanel>
                                    <TextBlock x:Name="Check" DockPanel.Dock="Left" Width="18" VerticalAlignment="Center" Visibility="Hidden"
                                               Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Foreground="{DynamicResource Attention}" />
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource Edge}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PopupMenu" TargetType="ContextMenu">
                <Setter Property="HasDropShadow" Value="False" />
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource ChoiceItem}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Margin="8" Padding="4" CornerRadius="10" Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Edge}" BorderThickness="1" Effect="{StaticResource Shadow}">
                                <ItemsPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ContextMenu x:Key="TextMenu" x:Shared="False" Style="{StaticResource PopupMenu}">
                <MenuItem Header="{DynamicResource Edit.Cut}" Command="ApplicationCommands.Cut" />
                <MenuItem Header="{DynamicResource Edit.Copy}" Command="ApplicationCommands.Copy" />
                <MenuItem Header="{DynamicResource Edit.Paste}" Command="ApplicationCommands.Paste" />
            </ContextMenu>

            <Style TargetType="TextBox">
                <Setter Property="SelectionBrush" Value="{DynamicResource Attention}" />
                <Setter Property="ContextMenu" Value="{DynamicResource TextMenu}" />
            </Style>

            <Style TargetType="FlowDocumentScrollViewer">
                <Setter Property="SelectionBrush" Value="{DynamicResource Attention}" />
                <Setter Property="ContextMenu" Value="{DynamicResource TextMenu}" />
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                <Setter Property="Background" Value="{DynamicResource Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HasDropShadow" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
