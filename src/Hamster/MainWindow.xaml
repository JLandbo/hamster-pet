<Window x:Class="Hamster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hamster"
        Title="Hamster"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" Width="396" Height="1200" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Loaded="Window_Loaded" Closed="Window_Closed" MouseMove="Window_MouseMove"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">

    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#F0262626" />
        <SolidColorBrush x:Key="Edge" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="Text" Color="#F2F2F2" />
        <SolidColorBrush x:Key="Muted" Color="#B8B8B8" />
        <SolidColorBrush x:Key="Attention" Color="#F5C542" />

        <DropShadowEffect x:Key="Shadow" BlurRadius="12" ShadowDepth="2" Opacity="0.35" />
        <local:MarkdownConverter x:Key="Markdown" />
        <!-- The theme gives flow documents Georgia, justified text and page padding instead of the bubble's look. -->
        <Style TargetType="FlowDocument">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="PagePadding" Value="0" />
        </Style>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#6FA8FF" />
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <!-- The Windows theme gives scrollbars a 17 px minimum, which would cover the edge of the bubbles. -->
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="#99FFFFFF" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="#3A3A3A" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="{StaticResource Attention}" />
            <Setter Property="Foreground" Value="#1E1E1E" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="12,7" />
        </Style>

        <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="7,7" />
        </Style>

        <Style x:Key="ChoiceItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="8,5,14,5">
                            <DockPanel>
                                <TextBlock x:Name="Check" DockPanel.Dock="Left" Width="18" VerticalAlignment="Center" Visibility="Hidden"
                                           Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                           Foreground="{StaticResource Attention}" />
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Edge}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceMenu" TargetType="ContextMenu">
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ChoiceItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Margin="8" Padding="4" CornerRadius="10" Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Edge}" BorderThickness="1" Effect="{StaticResource Shadow}">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Padding" Value="4" />
        </Style>
    </Window.Resources>

    <StackPanel x:Name="Root" VerticalAlignment="Bottom" SizeChanged="Root_SizeChanged">
        <!-- Slides down into the toolbar's place while the toolbar is faded out. -->
        <StackPanel>
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="IdleOffset" />
            </StackPanel.RenderTransform>
            <ScrollViewer x:Name="ChatScroll" Background="#01000000" Focusable="False"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="ChatScroll_PreviewMouseWheel">
                <!-- The system template reserves a 17 px column for the scrollbar; here the slim one overlays the margin instead,
                     so the bubbles are exactly as wide as the toolbar. -->
                <ScrollViewer.Template>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter />
                            <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right"
                                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </ScrollViewer.Template>
                <ItemsControl x:Name="ChatList" Margin="8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ChatItem}">
                            <Border x:Name="Bubble" Margin="0,4" Padding="14,10" CornerRadius="14"
                                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="&#xE711;" ToolTip="Slet besked" Click="DeleteChat_Click"
                                                Style="{StaticResource SmallIconButton}" Margin="6,-2,-6,0" VerticalAlignment="Top" />
                                        <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="8" Height="8" Margin="0,6,8,0"
                                                 VerticalAlignment="Top" Fill="#6FA8FF" />
                                        <TextBlock Text="{Binding Prompt}" Foreground="{StaticResource Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Activity}" Margin="16,0,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" ToolTip="{Binding}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                                           Foreground="{StaticResource Muted}" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <FlowDocumentScrollViewer Document="{Binding DisplayAnswer, Converter={StaticResource Markdown}}" Margin="16,4,0,0"
                                                              VerticalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}"
                                                              RequestBringIntoView="Answer_RequestBringIntoView" Hyperlink.RequestNavigate="Link_RequestNavigate"
                                                              Foreground="{StaticResource Muted}" />
                                    <ItemsControl ItemsSource="{Binding Requests}" Margin="16,0,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:UserRequest}">
                                                <StackPanel Margin="0,10,0,0">
                                                    <TextBlock Text="Kræver din tilladelse" Foreground="{StaticResource Attention}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" Margin="0,4,0,2" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                                               FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                                        <Button Content="Afvis" Click="Deny_Click" Style="{StaticResource PillButton}" />
                                                        <Button Content="Tillad" Click="Allow_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Busy">
                                    <Setter TargetName="Dot" Property="Fill" Value="#E08F60" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                    <Setter TargetName="Dot" Property="Fill" Value="#FF6B6B" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NeedsAction}" Value="True">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Attention}" />
                                    <Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource Attention}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Right-aligned with the toolbar and the chat bubbles. -->
            <Image x:Name="Pet" Width="160" Height="144" Margin="0,4,8,0" HorizontalAlignment="Right" Cursor="Hand"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" RenderTransformOrigin="0.5,0.5"
                   MouseLeftButtonDown="Pet_MouseLeftButtonDown" MouseMove="Pet_MouseMove" MouseLeftButtonUp="Pet_MouseLeftButtonUp"
                   LostMouseCapture="Pet_LostMouseCapture" MouseEnter="Pet_MouseEnterOrLeave" MouseLeave="Pet_MouseEnterOrLeave">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="Facing" />
                </Image.RenderTransform>
                <Image.ContextMenu>
                    <ContextMenu Style="{StaticResource ChoiceMenu}">
                        <MenuItem Header="Ny samtale" Click="NewChat_Click" />
                        <MenuItem Header="Afslut" Click="Exit_Click" />
                    </ContextMenu>
                </Image.ContextMenu>
            </Image>
        </StackPanel>

        <!-- The same 8 px gutter as the chat bubbles, so it is as wide as they are, and placing it on screen keeps incoming messages on screen too. -->
        <Border x:Name="Toolbar" Margin="8,6,8,0" Padding="4" CornerRadius="16"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Effect="{StaticResource Shadow}">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="CostText" DockPanel.Dock="Left" ToolTip="Claudes estimerede pris for samtalen" Foreground="{StaticResource Muted}"
                           FontSize="11" VerticalAlignment="Center" Margin="10,0,2,0" />
                <Button x:Name="ModelButton" DockPanel.Dock="Left" ToolTip="Model" Click="ShowChoices_Click" Style="{StaticResource TextButton}">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource ChoiceMenu}" MenuItem.Click="Model_Click">
                            <MenuItem Header="Fable 5.1" Tag="claude-fable-5-1" />
                            <MenuItem Header="Opus 5.5" Tag="claude-opus-5-5" />
                            <MenuItem Header="Sonnet 5" Tag="claude-sonnet-5" />
                            <MenuItem Header="Haiku 4.5" Tag="claude-haiku-4-5-20251001" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="EffortButton" DockPanel.Dock="Left" ToolTip="Effort" Click="ShowChoices_Click" Style="{StaticResource TextButton}">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource ChoiceMenu}" MenuItem.Click="Effort_Click">
                            <MenuItem Header="low" Tag="low" />
                            <MenuItem Header="medium" Tag="medium" />
                            <MenuItem Header="high" Tag="high" />
                            <MenuItem Header="xhigh" Tag="xhigh" />
                            <MenuItem Header="max" Tag="max" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="ModeButton" DockPanel.Dock="Left" ToolTip="Mode" Click="ShowChoices_Click" Style="{StaticResource TextButton}">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource ChoiceMenu}" MenuItem.Click="Mode_Click">
                            <MenuItem Header="plan" Tag="plan" />
                            <MenuItem Header="manual" Tag="default" />
                            <MenuItem Header="auto edit" Tag="acceptEdits" />
                            <MenuItem Header="auto" Tag="auto" />
                            <MenuItem Header="bypass" Tag="bypassPermissions" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="&#xE8A7;" ToolTip="Åbn Claude-appen" Click="OpenClaude_Click" Style="{StaticResource IconButton}" />
                    <Button Content="&#xE70F;" ToolTip="Skriv" Click="Write_Click" Style="{StaticResource IconButton}" />
                    <Button x:Name="ToggleChats" Content="&#xE70D;" ToolTip="Vis/skjul chats" Click="ToggleChats_Click" Style="{StaticResource IconButton}" />
                    <Button x:Name="StopButton" Content="&#xE71A;" ToolTip="Stop" Click="Stop_Click" Style="{StaticResource IconButton}" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Hidden, not collapsed: its space stays reserved, so showing it doesn't push the hamster up. -->
        <Border x:Name="InputBox" Margin="8,6,8,4" Padding="12,8" CornerRadius="14" Visibility="Hidden"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Effect="{StaticResource Shadow}">
            <DockPanel>
                <Button x:Name="AttachmentChip" DockPanel.Dock="Left" Visibility="Collapsed" Click="ClearAttachments_Click"
                        Style="{StaticResource PillButton}" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Top">
                    <TextBlock FontSize="11">
                        <Run FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE723;" />
                        <Run x:Name="AttachmentCount" />
                    </TextBlock>
                </Button>
                <TextBox x:Name="Input" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                         CaretBrush="{StaticResource Text}" TextWrapping="Wrap" KeyDown="Input_KeyDown" PreviewKeyDown="Input_PreviewKeyDown"
                         MaxHeight="160" VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
