<UserControl x:Class="Hamster.Views.MusicBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Bubble" Margin="8,0,-8,6" Padding="14,0,8,0" Height="36" CornerRadius="18" Visibility="Collapsed"
            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" Effect="{StaticResource Shadow}">
        <DockPanel VerticalAlignment="Center">
            <Button DockPanel.Dock="Right" Content="&#xE893;" ToolTip="{DynamicResource Main.NextTrack}" Click="NextTrack_Click" Style="{StaticResource SmallIconButton}" />
            <Button x:Name="PlayPauseButton" DockPanel.Dock="Right" Click="PlayPause_Click" Style="{StaticResource SmallIconButton}" />
            <Button DockPanel.Dock="Right" Content="&#xE892;" ToolTip="{DynamicResource Main.PreviousTrack}" Click="PreviousTrack_Click" Style="{StaticResource SmallIconButton}" />
            <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run FontFamily="{StaticResource IconFont}" Text="&#xEC4F;" />
                <Run x:Name="TrackText" />
            </TextBlock>
        </DockPanel>
    </Border>
</UserControl>
