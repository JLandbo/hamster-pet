<Window x:Class="Hamster.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hamster"
        Title="Indstillinger" Width="560" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" FontSize="13" Activated="Window_Activated" Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="#1E1E1E">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left" Fill="{StaticResource Muted}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Attention}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="#1E1E1E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type local:FieldInput}">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Field.Label}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,2" />
                <TextBox x:Name="Plain" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" CaretBrush="{StaticResource Text}" Style="{StaticResource Field}" />
                <PasswordBox x:Name="Secret" Visibility="Collapsed" PasswordChanged="Secret_PasswordChanged" CaretBrush="{StaticResource Text}" Style="{StaticResource Field}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Field.Secret}" Value="True">
                    <Setter TargetName="Plain" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Secret" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="12" Padding="20,16,20,20" CornerRadius="16" Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Edge}" BorderThickness="1" Effect="{StaticResource Shadow}"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="&#xE711;" ToolTip="Luk" Click="Close_Click" Style="{StaticResource SmallIconButton}" VerticalAlignment="Center" />
                <TextBlock Text="Indstillinger" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold" />
            </DockPanel>

            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="&#xE710;" ToolTip="Tilføj karakter (en kopi af hamsteren, som du kan tegne om)" Click="AddCharacter_Click"
                        Style="{StaticResource SmallIconButton}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="Karakter" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl x:Name="CharacterList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:CharacterChoice}">
                        <Border x:Name="Tile" Margin="0,0,8,8" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent">
                            <Button Click="Character_Click" ToolTip="{Binding Problem}" Style="{StaticResource PillButton}" Padding="10,8">
                                <StackPanel>
                                    <Image Source="{Binding Preview}" Width="80" Height="72" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Attention}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Connectors" Foreground="{StaticResource Muted}" Margin="0,16,0,8" />
            <TextBlock x:Name="ConnectorProblem" Foreground="{StaticResource Attention}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
            <ItemsControl x:Name="ConnectorList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ConnectorRow}">
                        <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="10" Background="#14FFFFFF">
                            <StackPanel>
                                <DockPanel>
                                    <ToggleButton x:Name="Switch" DockPanel.Dock="Right" VerticalAlignment="Center" Visibility="Collapsed" Style="{StaticResource Switch}"
                                                  IsChecked="{Binding On, Mode=OneWay}" IsEnabled="{Binding Idle}" Click="Toggle_Click" />
                                    <Button x:Name="EditButton" DockPanel.Dock="Right" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,8,0"
                                            Content="Rediger…" Click="Edit_Click" Style="{StaticResource TextButton}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Connector.Title}" Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding State}" ToolTip="{Binding State}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="TokenText" Text="Token: ••••••••" Foreground="{StaticResource Muted}" FontSize="11" Visibility="Collapsed" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,8,0,0">
                                    <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding UsesClaudeAi, Mode=OneWay}" Click="ClaudeAi_Click" Style="{StaticResource Switch}" />
                                    <TextBlock Text="Brug Claude AI connector" Foreground="{StaticResource Text}" FontSize="11" VerticalAlignment="Center" />
                                </DockPanel>
                                <StackPanel x:Name="Form" Margin="0,10,0,0" Visibility="Collapsed">
                                    <ItemsControl ItemsSource="{Binding Inputs}" />
                                    <DockPanel x:Name="Write" Margin="0,2,0,10" Visibility="Collapsed">
                                        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding AllowWrite}" Style="{StaticResource Switch}" />
                                        <TextBlock Text="Tillad skrivning" Foreground="{StaticResource Text}" FontSize="11" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Installér" Click="Install_Click" IsEnabled="{Binding Idle}" Style="{StaticResource PrimaryButton}" />
                                        <TextBlock VerticalAlignment="Center" FontSize="11">
                                            <Hyperlink NavigateUri="{Binding Connector.TokenPage}" RequestNavigate="TokenPage_RequestNavigate" Foreground="#6FA8FF">Opret token</Hyperlink>
                                        </TextBlock>
                                    </DockPanel>
                                </StackPanel>
                                <TextBlock x:Name="ProblemText" Text="{Binding Problem}" Foreground="{StaticResource Attention}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding CanToggle}" Value="True">
                                <Setter TargetName="Switch" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CanEdit}" Value="True">
                                <Setter TargetName="EditButton" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasToken}" Value="True">
                                <Setter TargetName="TokenText" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShowForm}" Value="True">
                                <Setter TargetName="Form" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Connector.CanBeReadOnly}" Value="True">
                                <Setter TargetName="Write" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Problem}" Value="{x:Null}">
                                <Setter TargetName="ProblemText" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
