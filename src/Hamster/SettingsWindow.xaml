<Window x:Class="Hamster.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hamster"
        Title="{DynamicResource Settings.Title}" Width="560" Height="660" MinWidth="480" MinHeight="200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" FontSize="13" Activated="Window_Activated" Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="16" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
            <Setter Property="Margin" Value="5,0,0,0" />
        </Style>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Background" Value="{DynamicResource Input}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="TextBoxBase.SelectionBrush" Value="{DynamicResource Attention}" />
            <Setter Property="ContextMenu" Value="{DynamicResource TextMenu}" />
        </Style>

        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="{DynamicResource Input}">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource Muted}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Attention}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAttention}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type local:FieldInput}">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Field.Label}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,2" />
                <TextBox x:Name="Plain" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" CaretBrush="{DynamicResource Text}" Style="{StaticResource Field}" />
                <PasswordBox x:Name="Secret" Visibility="Collapsed" PasswordChanged="Secret_PasswordChanged" CaretBrush="{DynamicResource Text}" Style="{StaticResource Field}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Field.Secret}" Value="True">
                    <Setter TargetName="Plain" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Secret" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ChoiceTemplate" DataType="{x:Type local:Choice}">
            <CheckBox Content="{Binding Title}" IsChecked="{Binding Chosen, Mode=OneWay}" Click="Choice_Click"
                      IsEnabled="{Binding DataContext.Idle, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      FontSize="12" Margin="0,6,0,0" />
        </DataTemplate>
    </Window.Resources>

    <Border Margin="12" Padding="20,16,20,20" CornerRadius="16" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Edge}" BorderThickness="1" Effect="{StaticResource Shadow}"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="&#xE711;" ToolTip="{DynamicResource Common.Close}" Click="Close_Click" Style="{StaticResource SmallIconButton}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource Settings.Title}" Foreground="{DynamicResource Text}" FontSize="18" FontWeight="SemiBold" />
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>

                    <DockPanel Margin="0,0,0,16">
                        <Border DockPanel.Dock="Right" Padding="2" CornerRadius="8" Background="{DynamicResource Input}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="DanishButton" Content="Dansk" Click="Language_Click" Style="{StaticResource Segment}" />
                                <ToggleButton x:Name="EnglishButton" Content="English" Click="Language_Click" Style="{StaticResource Segment}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource Settings.Language}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{DynamicResource Settings.Theme}" Foreground="{DynamicResource Muted}" Margin="0,0,0,8" />
                    <ItemsControl x:Name="ThemeList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ThemeChoice}">
                                <Border x:Name="Tile" Margin="0,0,8,8" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent">
                                    <Button Click="Theme_Click" Style="{StaticResource PillButton}" Padding="10,8">
                                        <StackPanel>
                                            <Border Width="80" Height="48" CornerRadius="6" Padding="8" Background="{Binding Surface}" BorderBrush="{Binding Edge}" BorderThickness="1">
                                                <Grid>
                                                    <StackPanel>
                                                        <Border Width="44" Height="5" CornerRadius="2.5" Background="{Binding Text}" HorizontalAlignment="Left" />
                                                        <Border Width="30" Height="5" CornerRadius="2.5" Background="{Binding Muted}" HorizontalAlignment="Left" Margin="0,5,0,0" />
                                                    </StackPanel>
                                                    <Border Width="22" Height="9" CornerRadius="4.5" Background="{Binding Attention}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="12" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Button>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Selected}" Value="True">
                                        <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Attention}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel Margin="0,16,0,8">
                        <Button DockPanel.Dock="Right" Content="&#xE710;" ToolTip="{DynamicResource Settings.AddCharacter}" Click="AddCharacter_Click"
                                Style="{StaticResource SmallIconButton}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Settings.Character}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl x:Name="CharacterList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CharacterChoice}">
                                <Border x:Name="Tile" Margin="0,0,8,8" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent">
                                    <Button Click="Character_Click" ToolTip="{Binding Problem}" Style="{StaticResource PillButton}" Padding="10,8">
                                        <StackPanel>
                                            <Image Source="{Binding Preview}" Width="80" Height="72" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="12" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Button>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Selected}" Value="True">
                                        <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Attention}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{DynamicResource Settings.Connectors}" Foreground="{DynamicResource Muted}" Margin="0,16,0,8" />
                    <TextBlock x:Name="ConnectorProblem" Foreground="{DynamicResource Attention}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
                    <ItemsControl x:Name="ConnectorList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ConnectorRow}">
                                <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="10" Background="{DynamicResource Card}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Padding="2" CornerRadius="8" Background="{DynamicResource Input}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ToggleButton Content="{DynamicResource Settings.Off}" Tag="{x:Static local:ConnectorSource.Off}" IsChecked="{Binding IsOff, Mode=OneWay}"
                                                                  IsEnabled="{Binding Idle}" Click="Source_Click" Style="{StaticResource Segment}" />
                                                    <ToggleButton x:Name="HamsterSource" Content="Hamster" Tag="{x:Static local:ConnectorSource.Hamster}" IsChecked="{Binding IsHamster, Mode=OneWay}"
                                                                  IsEnabled="{Binding Idle}" Click="Source_Click" Style="{StaticResource Segment}" />
                                                    <ToggleButton Content="Claude AI" Tag="{x:Static local:ConnectorSource.ClaudeAi}" IsChecked="{Binding IsClaudeAi, Mode=OneWay}"
                                                                  IsEnabled="{Binding Idle}" Click="Source_Click" Style="{StaticResource Segment}" />
                                                    <ToggleButton x:Name="LoginSource" Content="{DynamicResource Settings.LoginSource}" Tag="{x:Static local:ConnectorSource.Login}" IsChecked="{Binding IsLogin, Mode=OneWay}"
                                                                  IsEnabled="{Binding Idle}" Click="Source_Click" Style="{StaticResource Segment}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding Connector.Title}" Foreground="{DynamicResource Text}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <DockPanel Margin="0,2,0,0">
                                            <Button x:Name="LoginButton" DockPanel.Dock="Right" Content="{Binding LoginLabel}" Click="Login_Click" IsEnabled="{Binding Idle}"
                                                    Style="{StaticResource TextButton}" Padding="6,2" Visibility="Collapsed" />
                                            <Button x:Name="EditButton" DockPanel.Dock="Right" Content="{DynamicResource Settings.EditToken}" Click="Edit_Click"
                                                    Style="{StaticResource TextButton}" Padding="6,2" Visibility="Collapsed" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding State}" ToolTip="{Binding State}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBox x:Name="SiteBox" Text="{Binding SiteInput, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,8,0" FontSize="12" VerticalAlignment="Center"
                                                     CaretBrush="{DynamicResource Text}" Style="{StaticResource Field}" Visibility="Hidden" />
                                        </DockPanel>
                                        <StackPanel x:Name="Form" Margin="0,10,0,0" Visibility="Collapsed">
                                            <ItemsControl ItemsSource="{Binding Inputs}" />
                                            <DockPanel x:Name="Write" Margin="0,2,0,10" Visibility="Collapsed">
                                                <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding AllowWrite}" Style="{StaticResource Switch}" />
                                                <TextBlock Text="{DynamicResource Settings.AllowWrite}" Foreground="{DynamicResource Text}" FontSize="12" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="{DynamicResource Settings.Save}" Click="Install_Click" IsEnabled="{Binding Idle}" Style="{StaticResource PrimaryButton}" />
                                                <TextBlock VerticalAlignment="Center" FontSize="12">
                                                    <Hyperlink NavigateUri="{Binding Connector.TokenPage}" RequestNavigate="TokenPage_RequestNavigate"><Run Text="{DynamicResource Settings.CreateToken}" /></Hyperlink>
                                                </TextBlock>
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel x:Name="Subscribe" Margin="0,8,0,0" Visibility="Collapsed">
                                            <DockPanel>
                                                <Button x:Name="FetchChoices" DockPanel.Dock="Right" Content="{DynamicResource Settings.FetchBoards}" Click="FetchStatuses_Click" IsEnabled="{Binding Idle}"
                                                        Style="{StaticResource TextButton}" Padding="6,2" Visibility="Collapsed" />
                                                <TextBlock Text="{DynamicResource Settings.SubscribeTo}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock x:Name="ChoicesText" Text="{Binding ChoicesText}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel x:Name="Boards" Margin="0,0,12,0">
                                                    <TextBlock Text="{DynamicResource Settings.Boards}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0" />
                                                    <ItemsControl ItemsSource="{Binding BoardChoices}" ItemTemplate="{StaticResource ChoiceTemplate}" />
                                                </StackPanel>
                                                <StackPanel x:Name="ChoicesPanel" Grid.Column="1">
                                                    <TextBlock x:Name="ColumnsLabel" Text="{DynamicResource Settings.Columns}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0" />
                                                    <ItemsControl ItemsSource="{Binding Choices}" ItemTemplate="{StaticResource ChoiceTemplate}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock x:Name="ProblemText" Text="{Binding Problem}" Foreground="{DynamicResource Attention}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Connector.Installable}" Value="False">
                                        <Setter TargetName="HamsterSource" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Connector.Login}" Value="{x:Null}">
                                        <Setter TargetName="LoginSource" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLogin}" Value="True">
                                        <Setter TargetName="LoginButton" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NeedsSite}" Value="True">
                                        <Setter TargetName="SiteBox" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CanEdit}" Value="True">
                                        <Setter TargetName="EditButton" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowForm}" Value="True">
                                        <Setter TargetName="Form" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Connector.CanBeReadOnly}" Value="True">
                                        <Setter TargetName="Write" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasChoices}" Value="True">
                                        <Setter TargetName="Subscribe" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CanFetchChoices}" Value="True">
                                        <Setter TargetName="FetchChoices" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BoardChoices.Count}" Value="0">
                                        <Setter TargetName="Boards" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="ColumnsLabel" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="ChoicesPanel" Property="Grid.Column" Value="0" />
                                        <Setter TargetName="ChoicesPanel" Property="Grid.ColumnSpan" Value="2" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChoicesText}" Value="{x:Null}">
                                        <Setter TargetName="ChoicesText" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Problem}" Value="{x:Null}">
                                        <Setter TargetName="ProblemText" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
